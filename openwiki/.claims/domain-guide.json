    {
      "id": "claim_0933128f53e447aba6b5071b6a589f85",
      "statement": "sync.dedup.dedup_by_url implements an existing-wins strategy: incoming bookmarks whose normalized URL already exists in the store are silently dropped with no field merge, and within-batch duplicates in incoming are also collapsed (first occurrence wins).",
      "evidence": [
        {
          "resource": "repo://linkkeep/sync/dedup.py#L15-L29",
          "version": "repo-lines-v1:sha256:69a62f41a1e5eca131ba20400bd50689c09f7142f654fbc4c1757f563541a900:"
        }
      ]
    },
    {
      "id": "claim_e02e585d05b74191b333a54dd58b4a37",
      "statement": "sync.dedup.normalize_url strips whitespace, removes a single trailing slash, and lowercases the entire URL including path and query; thus only scheme/host case and a single trailing slash collapse, while path case differences remain distinct.",
