          "version": "repo-lines-v1:sha256:dbf29c86d81e695e52029047b21d532272a9594357afeab6345388882d56b783:"
        }
      ]
    },
    {
      "id": "claim_92434367a6f44c44b740409214bd607f",
      "statement": "CLI dispatch: build_parser() wires one subparser per subcommand to a handler in commands.py via set_defaults(func=handler); main() creates a single Store() and calls args.func(store, args). The export and import handlers delegate to sync.exporter and sync.importer rather than implementing file logic themselves.",
      "evidence": [
