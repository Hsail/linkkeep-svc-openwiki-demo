    {
      "id": "claim_eb1c9c4a933f4eafbb180f0c8758072f",
      "statement": "Bookmark is the single source of truth for the bookmark data shape (id, url, title, tags, created_at) with to_dict/from_dict providing the JSON serialization boundary. The API wraps it in Pydantic schemas (BookmarkIn/BookmarkOut/TagCount) while core stays framework-free; because all three interface domains share this model, data-model changes ripple across every domain.",
      "evidence": [
        {
          "resource": "repo://linkkeep/api/routes.py#L13-L24",
