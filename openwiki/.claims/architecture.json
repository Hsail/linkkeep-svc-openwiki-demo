        }
      ]
    },
    {
      "id": "claim_e0978f6b56264584a522379dc676b763",
      "statement": "import_from_json reads a JSON file, validates every item has a url field (raises ValueError if missing), converts to Bookmarks, loads existing bookmarks, dedups by normalized URL with existing-wins semantics, reassigns sequential IDs from next_id(existing) (discarding original imported IDs), saves the merged list, and returns the count of newly added bookmarks.",
