        }
      ]
    },
    {
      "id": "claim_fbd834b98f1a44bebeaeec5a6c9ba8a5",
      "statement": "Tags are stored as-is: Store.add and the API create endpoint pass tags through unchanged. Normalization (lowercase, strip) is applied only at statistics/query time inside core.tags functions (tag_counts, tag_overlap), so mixed-case tags persist in the JSON file though statistics collapse case variants.",
      "evidence": [
        {
          "resource": "repo://linkkeep/api/routes.py#L19-L22",
