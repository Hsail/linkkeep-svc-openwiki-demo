    },
    {
      "id": "claim_c21c227a601146cb868b75da05981805",
      "statement": "sync.dedup provides normalize_url (strips trailing slashes, lowercases the entire string), dedup_by_url (returns incoming bookmarks whose normalized URL is not in the existing set and not already seen earlier in the same incoming batch; existing wins, no overwrite), and dedup_stats (pre-import preview of incoming, fresh, and dropped counts).",
      "evidence": [
