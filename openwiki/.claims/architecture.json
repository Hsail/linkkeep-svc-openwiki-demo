    {
      "id": "claim_38d38022b07d4ff79ac75cfe10c9b0a1",
      "statement": "sync.importer.import_from_json reads a JSON file, validates each item has a url field (raises ValueError otherwise), deduplicates incoming bookmarks against existing Store bookmarks by normalized URL, reassigns IDs sequentially starting from store.next_id(existing), saves existing+fresh, and returns the count of newly added bookmarks.",
      "evidence": [
        {
          "resource": "repo://linkkeep/sync/importer.py#L1-L29",
