  "claims": [
    {
      "id": "claim_374c044c90344268be854af6eb5e295f",
      "statement": "linkkeep-svc has four domains: core (data foundation), api (FastAPI REST), cli (argparse), sync (export/import/dedup). api, cli, and sync all depend on core; cli additionally depends on sync for export/import, and the graph is otherwise acyclic (sync never imports cli/api; api never imports cli/sync).",
      "evidence": [
        {
          "resource": "repo://linkkeep/api/routes.py#L6-L8",
          "version": "repo-lines-v1:sha256:fe34e921fe0e8545284720624376baa3c8d5e8ec843b958811b78c76d693f83b:"
        },
        {
          "resource": "repo://linkkeep/cli/commands.py#L8-L9",
          "version": "repo-lines-v1:sha256:563048161b3a0b4d183b1c8063dd7dd3b31f26090156189a10b240a1309c18e1:"
        },
        {
          "resource": "repo://linkkeep/cli/main.py#L5-L6",
          "version": "repo-lines-v1:sha256:4ef9326e42e72defc830111e196ccf0d64e60e3472da520546283d78d83cfdcb:"
        },
        {
          "resource": "repo://linkkeep/sync/importer.py#L5-L7",
          "version": "repo-lines-v1:sha256:1bab57f274b93a622c12c02d596420a510d9417fde7ae3ba5561b4af599f354b:"
        }
