    {
      "id": "claim_febcbd4b0cb94553b3956a84deab146c",
      "statement": ".github/workflows/openwiki-update.yml runs a weekly scheduled OpenWiki documentation refresh at 08:00 UTC every Monday (cron '0 8 * * 1') plus a workflow_dispatch trigger. It installs OpenWiki via npm, runs `openwiki code --update --print`, and opens a PR. It requires OPENROUTER_API_KEY and a PAT with workflow scope (GH_PAT_WITH_WORKFLOW_SCOPE) used for both checkout and the PR step because the default GITHUB_TOKEN cannot commit changes under .github/workflows/.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L1-L44",
          "version": "repo-lines-v1:sha256:14332a71cc30b669e59bacaeba2f64c331d6db5ba15add993f0577a7989e5846:"
        }
      ]
    },
