    {
      "id": "claim_b34874540be9476f9ef1544da392d658",
      "statement": "Tag normalization is lowercase+strip (normalize_tag) applied inside tag_counts/top_tags/tag_overlap, but NOT inside Store.add, so tags are stored as-is in the JSON file. CLI list --tag / count --tag and API ?tag= filters call the case-sensitive Bookmark.matches_tag directly without normalizing the query, so filter surfaces are case-sensitive while tag-overview surfaces are not.",
      "evidence": [
        {
          "resource": "repo://linkkeep/api/routes.py#L13-L18",
